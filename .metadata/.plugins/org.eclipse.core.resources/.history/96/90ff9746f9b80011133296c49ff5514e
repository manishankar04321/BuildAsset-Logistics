spring.application.name=api-gateway
server.port=8090

eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true

spring.cloud.gateway.server.webmvc.routes[0].id=contractor-service
spring.cloud.gateway.server.webmvc.routes[0].uri=lb://CONTRACTOR-SERVICE
spring.cloud.gateway.server.webmvc.routes[0].predicates[0]=Path=/contractors/**

spring.cloud.gateway.server.webmvc.routes[1].id=equipment-service
spring.cloud.gateway.server.webmvc.routes[1].uri=lb://EQUIPMENT-SERVICE
spring.cloud.gateway.server.webmvc.routes[1].predicates[0]=Path=/equipment/**

spring.cloud.gateway.server.webmvc.routes[2].id=rental-service
spring.cloud.gateway.server.webmvc.routes[2].uri=lb://RENTAL-SERVICE
spring.cloud.gateway.server.webmvc.routes[2].predicates[0]=Path=/rentals/**

spring.cloud.gateway.server.webmvc.routes[3].id=dispatch-service
spring.cloud.gateway.server.webmvc.routes[3].uri=lb://DISPATCH-SERVICE
spring.cloud.gateway.server.webmvc.routes[3].predicates[0]=Path=/dispatch/**
# JWT Configuration
jwt.secret=BuildAssetLogisticsJwtSecretKey2026ForAuthentication
jwt.expiration-ms=86400000